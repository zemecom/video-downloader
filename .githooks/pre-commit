#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

mapfile -t staged_php_files < <(
  git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '^(src/.*\.php|tests/.*\.php|run\.php|ytd\.php|bin/ytd)$' || true
)

if [ "${#staged_php_files[@]}" -gt 0 ]; then
  echo "pre-commit: auto-fixing staged PHP files..."
  make lint-fix FIXER_TARGETS="${staged_php_files[*]}"
  git add -- "${staged_php_files[@]}"
else
  echo "pre-commit: no staged PHP files to auto-fix."
fi

echo "pre-commit: running local CI for the current PHP version..."
make ci-current
