# Proxy for routes from proxy_rules.yaml -> local
# macOS/Linux example: http://127.0.0.1:8881
# Windows example: http://127.0.0.1:8881
PROXY_LOCAL=http://127.0.0.1:8881

# Proxy for routes from proxy_rules.yaml -> remote
# Replace this example with your real remote proxy
PROXY_REMOTE=http://user:pass@example.com:3128

# Path to routing rules, relative paths resolve from the detected runtime project root
PROXY_RULES_FILE=proxy_rules.yaml

# Download folders
# macOS/Linux examples: ~/Movies/Downloaded/Youtube and ~/Movies/Downloaded
# Windows examples: C:\Users\YourName\Videos\Downloaded\Youtube and C:\Users\YourName\Videos\Downloaded
DOWNLOAD_DIR_YOUTUBE=~/Movies/Downloaded/Youtube
DOWNLOAD_DIR_GENERAL=~/Movies/Downloaded

# Final container format: mkv or mp4
OUTPUT_FORMAT=mkv

# How many playlist items may download in parallel
CONCURRENT_DOWNLOADS=1

# How many fragments yt-dlp may download in parallel for a single file
CONCURRENT_FRAGMENTS=20

# How often yt-dlp should refresh progress output, in seconds
YTD_PROGRESS_DELTA=0.5

# Set to 1/true/yes to print progress line-by-line instead of redraw
YTD_PROGRESS_NEWLINE=

# Optional real URLs for manual integration tests
# Leave these values empty if you don't plan to run network-dependent tests.
TEST_URL_DIRECT=
TEST_URL_REMOTE=
TEST_URL_LOCAL=
# Manual and potentially fragile playlist scenario for local-route integration testing
TEST_PLAYLIST_LOCAL=

# Путь к исполняемому файлу yt-dlp (по умолчанию: yt-dlp)
YT_DLP_PATH=yt-dlp
