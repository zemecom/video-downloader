#!/usr/bin/env php
<?php

declare(strict_types=1);

use YtdPhp\Runtime\RuntimeBootstrap;
use YtdPhp\NativeHost\NativeHostPreviewHttpResponder;
use YtdPhp\NativeHost\NativeHostPreviewRegistryService;
use YtdPhp\NativeHost\NativeHostPreviewServerService;
use YtdPhp\NativeHost\NativeHostPreviewServerStateStore;

require dirname(__DIR__) . '/vendor/autoload.php';

$bootstrap = new RuntimeBootstrap(dirname(__DIR__));
$bootstrap->ensureProjectRoot();
$bootstrap->initializeEnvironment();

$server = new NativeHostPreviewServerService(
    new NativeHostPreviewServerStateStore($bootstrap),
    new NativeHostPreviewHttpResponder(new NativeHostPreviewRegistryService($bootstrap)),
);

exit($server->run());
